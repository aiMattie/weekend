# --- Ports ---
# PORT: port of `npm run local` (npm run setup picks a random free one). HOST_PORT: host port of the Docker container.
# PORT=3514
HOST_PORT=3058
# Optional Docker names, e.g. after your domain: COMPOSE_PROJECT_NAME=weekend_example_com, CONTAINER_NAME=weekend.example.com (default: weekend)
# COMPOSE_PROJECT_NAME=weekend
# CONTAINER_NAME=weekend

# --- App ---
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1

# --- Database (SQLite file, relative to the project root; data/ is gitignored + a docker volume) ---
DATABASE_URL=file:data/app.db

# --- Auth ---
# Long random string used to sign session cookies (jose HS256). Generate: openssl rand -base64 48
SESSION_SECRET=
# Password given to every seeded user (dev only)
SEED_PASSWORD=Welkom123!

# --- Google SSO (Admin > Single sign-on). Without GOOGLE_CLIENT_ID/SECRET there is no Google button and password login keeps working ---
# GOOGLE_CLIENT_ID=                     OAuth client (Google Cloud Console > APIs & Services > Credentials, type "Web application")
# GOOGLE_CLIENT_SECRET=
# APP_URL=http://localhost:3058         public base URL; redirect URI = ${APP_URL}/api/auth/google/callback
# GOOGLE_ALLOWED_DOMAINS=example.com,example.org   optional: only these domains may sign in (merged with Admin > Single sign-on)
# Test hooks, ONLY honoured with E2E_RESET=1 (point sign-in at a local mock IdP):
# GOOGLE_OAUTH_BASE=                    base for /auth /token /jwks
# GOOGLE_AUTH_URL= / GOOGLE_TOKEN_URL= / GOOGLE_JWKS_URL=   per endpoint overrides

# --- Microsoft SSO (Admin > Single sign-on). Without MICROSOFT_CLIENT_ID/SECRET there is no Microsoft button ---
# Domains, auto-provisioning and "SSO only" are shared with Google (Admin > Single sign-on).
# MICROSOFT_CLIENT_ID=                  Application (client) ID (Entra admin center > App registrations, platform "Web")
# MICROSOFT_CLIENT_SECRET=              client secret value (Certificates & secrets)
# MICROSOFT_TENANT_ID=                  your Directory (tenant) ID (recommended). Default "organizations" = any work account;
#                                       "common" also allows personal accounts. Redirect URI = ${APP_URL}/api/auth/microsoft/callback
# Test hooks, ONLY honoured with E2E_RESET=1: MICROSOFT_OAUTH_BASE= (base for /authorize /token /keys), MICROSOFT_ISSUER_BASE=

# --- Test harness ---
# E2E_PORT=3058
# NEXT_DIST_DIR=.next-e2e   (per-agent dist dir, never share .next between dev servers)

# --- Importer (scripts/ only, never the browser) ---
# MONDAY_API_KEY=                        fallback; prefer linking monday.com under Admin > Import (stored encrypted)
# JIRA_BASE_URL= / JIRA_EMAIL= / JIRA_API_TOKEN=   fallback for the Jira sync (scripts/migrate-jira.ts, Admin > Import); prefer linking Jira under Admin > Import
# IMPORT_SCHEDULER=off                  disables the scheduled monday.com / Jira syncs (Admin > Import)

# --- API / MCP limits (platform module; all optional, defaults shown) ---
# PUBLIC_URL=http://localhost:3058      base URL used in links returned by the API and MCP upload URLs
# API_DAILY_BUDGET=5000000              complexity points per token per UTC day (a token can override it)
# API_MINUTE_BUDGET=10000000            complexity points per token per minute
# API_MAX_COMPLEXITY=5000000            max complexity of a single query
# API_REQUESTS_PER_MINUTE=5000          requests per token per minute
# API_MAX_DEPTH=12                      max GraphQL query depth
# API_CURSOR_TTL_MINUTES=60             lifetime of items_page cursors

# --- AI (module ai: Sidekick, agents, AI blocks, Notetaker). Without a key every AI screen shows "AI niet geconfigureerd" ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://llm.example.com      optional: company proxy / alternative endpoint
# AI_MODEL=claude-sonnet-5-5                   optional model override (also Admin > AI)
# AI_USER_MONTHLY_CREDITS=2000                 default per-user monthly credit limit (1 credit = 1000 weighted tokens, output x5)
# AI_ACCOUNT_MONTHLY_CREDITS=                  default account limit (empty = unlimited)
# AI_SCHEDULER=off                             disable the one-minute tick that runs scheduled agents

# --- Files / URLs ---
# FILES_DIR=data/files                  where uploaded files are stored (default <cwd>/data/files)
# APP_URL=http://localhost:3058         base URL used in automation e-mails/links (also NEXT_PUBLIC_APP_URL / APP_BASE_URL for templates)
# COOKIE_SECURE=1                       set to 1 behind HTTPS so the session cookie gets the Secure flag
# APP_TZ=Europe/Amsterdam               time zone of the automation scheduler

# --- Automations ---
# AUTOMATIONS_SCHEDULER=off             disable the one-minute scheduler tick
# AUTOMATION_BOARD_HOURLY_LIMIT=1000    max automation runs per board per hour
# AUTOMATION_ACCOUNT_MONTHLY_LIMIT=250000
# SMTP_HOST=127.0.0.1                   e-mail actions (send e-mail automation)
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_FROM=weekend@example.com

# --- Jira migration (scripts/migrate-jira.ts; without these the script runs against fixtures) ---
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=

# --- scripts/mcp-smoke.ts ---
# BASE_URL=http://localhost:3058
# MCP_TOKEN=                            API token; without it the script logs in as ADMIN_EMAIL
# ADMIN_EMAIL=owner@example.com

# --- Importer / e2e only ---
# MONDAY_API_URL=                       test hook: point the importer at a mock (only honoured with E2E_RESET=1)
# E2E_RESET=1                           enables POST /api/test/* endpoints. NEVER set in production
# E2E_REUSE=1                           Playwright reuses a running server on E2E_PORT
# PW_OUTPUT_DIR=/tmp/pw-results         Playwright output dir (keep it outside the project tree)
# RUN_MANUALS=1                         include e2e/manuals (npm run manuals)

# --- MCP request_change / list_change_requests ---
# CHANGE_REQUEST_BOARD_ID=              board for feature requests/bugs about this app (default: Weekend dev "Taken" board in workspace "Development")

# --- OAuth for the MCP endpoint (claude.ai connectors, Claude Desktop/mobile, Claude Code) ---
# Issuer = PUBLIC_URL, else APP_URL. Dynamic client registration accepts only these redirect hosts (https) plus loopback.
# OAUTH_REDIRECT_HOSTS=claude.ai,claude.com
# OAUTH_REGISTER_PER_HOUR=30            client registrations per IP per hour
